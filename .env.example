# ============================================================
# Environment template
# Copy to .env and fill in real values. Never commit .env.
# Every variable the code reads must be listed here, with a
# comment and a placeholder. Delete what your project does not use.
# Comments stay on their own lines: inline comments are not
# parsed the same way by every dotenv library.
# ============================================================

# --- Application -------------------------------------------
# production | development
APP_ENV=production
# true only in local development, never in production
APP_DEBUG=false
# Public base URL of the app, no trailing slash
APP_URL=https://example.com
# debug | info | warning | error
LOG_LEVEL=warning

# --- AI provider -------------------------------------------
# Server-side only, never exposed to the browser
ANTHROPIC_API_KEY=your-api-key-here
# Model alias or full model ID, verified against the provider docs
ANTHROPIC_MODEL=your-model-here

# --- Database ----------------------------------------------
# Full connection string, credentials included
DATABASE_URL=your-database-url-here
